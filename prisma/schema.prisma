enum ConnectorType {
  SERVICENOW
  JIRA
  AZURE_AD
  AZURE_DEVOPS
  CONFLUENCE
  SHAREPOINT
  GITHUB
  GITLAB
  BITBUCKET
  SLACK
  TEAMS
  SALESFORCE
  SAP
  ORACLE
  CMDB
  ITSM
  REST_API
  GRAPHQL_API
  SOAP_API
  DATABASE
  FILE_SYSTEM
  CSV_IMPORT
  EXCEL_IMPORT
  CUSTOM
}

enum ConnectorStatus {
  ACTIVE
  INACTIVE
  ERROR
  SYNCING
  PENDING_SETUP
  DISCONNECTED
}

enum SyncStatus {
  IDLE
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
  CANCELLED
}

enum DataMappingTransformType {
  DIRECT
  LOOKUP
  FORMULA
  SCRIPT
  AI_INFER
}

model ConnectorConfig {
  id              String   @id @default(cuid())
  name            String
  type            ConnectorType
  status          ConnectorStatus  @default(PENDING_SETUP)
  description     String?
  
  // Connection details (encrypted)
  credentials     Json             // API keys, OAuth tokens, etc.
  endpoint        String?          // API endpoint URL
  config          Json?            // Type-specific configuration
  
  // Sync settings
  syncEnabled     Boolean  @default(false)
  syncFrequency   String?          // cron expression
  lastSyncAt      DateTime?
  nextSyncAt      DateTime?
  autoSync        Boolean  @default(false)
  
  // Statistics
  totalSyncs      Int      @default(0)
  successfulSyncs Int      @default(0)
  failedSyncs     Int      @default(0)
  recordsImported Int      @default(0)
  recordsUpdated  Int      @default(0)
  recordsDeleted  Int      @default(0)
  
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  syncJobs        ConnectorSyncJob[]
  dataMappings    ConnectorDataMapping[]
  webhooks        WebhookConfig[]
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@map("connector_configs")
}

model ConnectorSyncJob {
  id              String   @id @default(cuid())
  connectorId     String
  status          SyncStatus
  startedAt       DateTime
  completedAt     DateTime?
  duration        Int?             // milliseconds
  
  // Statistics
  recordsProcessed Int     @default(0)
  recordsImported Int      @default(0)
  recordsUpdated  Int      @default(0)
  recordsSkipped  Int      @default(0)
  recordsFailed   Int      @default(0)
  
  // Error handling
  errors          Json?            // Array of error details
  warnings        Json?            // Array of warnings
  summary         String?
  logs            String?          // Detailed execution logs
  
  organizationId  String
  
  connector       ConnectorConfig @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([connectorId])
  @@index([status])
  @@index([startedAt])
  @@index([organizationId])
  @@map("connector_sync_jobs")
}

model ConnectorDataMapping {
  id              String   @id @default(cuid())
  connectorId     String
  name            String
  description     String?
  
  // Source mapping
  sourceEntity    String           // Source entity type (e.g., "ServiceNow.cmdb_ci")
  sourceField     String           // Source field name
  sourceType      String?          // Source data type
  
  // Target mapping
  targetEntity    String           // Target model (e.g., "Application")
  targetField     String           // Target field name
  targetType      String?          // Target data type
  
  // Transformation
  transformType   DataMappingTransformType @default(DIRECT)
  transformConfig Json?            // Transformation logic
  defaultValue    String?
  required        Boolean  @default(false)
  
  // Validation
  validationRules Json?
  
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  connector       ConnectorConfig @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([connectorId])
  @@index([sourceEntity])
  @@index([targetEntity])
  @@index([organizationId])
  @@map("connector_data_mappings")
}

model WebhookConfig {
  id              String   @id @default(cuid())
  connectorId     String
  name            String
  description     String?
  url             String           // Webhook endpoint
  secret          String?          // Webhook secret for validation
  events          Json             // Array of event types to listen for
  active          Boolean  @default(true)
  
  // Retry settings
  retryOnFailure  Boolean  @default(true)
  maxRetries      Int      @default(3)
  retryDelay      Int      @default(60) // seconds
  
  // Statistics
  totalCalls      Int      @default(0)
  successfulCalls Int      @default(0)
  failedCalls     Int      @default(0)
  lastCalledAt    DateTime?
  lastStatus      String?
  
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  connector       ConnectorConfig @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  logs            WebhookLog[]
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([connectorId])
  @@index([active])
  @@index([organizationId])
  @@map("webhook_configs")
}

model WebhookLog {
  id              String   @id @default(cuid())
  webhookId       String
  event           String
  payload         Json?
  response        Json?
  statusCode      Int?
  success         Boolean
  errorMessage    String?
  executedAt      DateTime @default(now())
  duration        Int?             // milliseconds
  
  organizationId  String
  
  webhook         WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([webhookId])
  @@index([executedAt])
  @@index([success])
  @@index([organizationId])
  @@map("webhook_logs")
}

model MCPServer {
  id              String   @id @default(cuid())
  name            String
  description     String?
  serverUrl       String
  apiKey          String?
  status          ConnectorStatus  @default(PENDING_SETUP)
  capabilities    Json?            // Array of MCP capabilities
  config          Json?
  
  // AI Discovery settings
  aiModel         String?          // GPT-4, Claude, etc.
  discoveryEnabled Boolean @default(true)
  autoMapping     Boolean  @default(true)
  
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([status])
  @@map("mcp_servers")
}


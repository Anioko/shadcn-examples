// ==============================================================================

enum CodeLanguage {
  TYPESCRIPT
  JAVASCRIPT
  PYTHON
  JAVA
  CSHARP
  GO
  RUST
  RUBY
  PHP
  SQL
}

enum CodeFramework {
  REACT
  NEXTJS
  ANGULAR
  VUE
  NESTJS
  EXPRESS
  DJANGO
  FLASK
  SPRING_BOOT
  DOTNET_CORE
  LARAVEL
  RAILS
}

enum GenerationStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

model CodeTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  language        CodeLanguage
  framework       CodeFramework?
  category        String?          // Component, API, Service, etc.
  

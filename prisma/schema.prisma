  acronym           String?                   @db.VarChar(20)
  version           String                    @default("1.0") @db.VarChar(20)
  description       String                    @db.Text
  longDescription   String?                   @db.Text
  
  // Classification
  category          FrameworkCategory
  subcategory       String?                   @db.VarChar(100)
  domain            FrameworkDomain
  industry          String[]                  // Industries this applies to
  organizationSize  String[]                  // startup, small, medium, large, enterprise
  maturityLevel     String[]                  // basic, intermediate, advanced, expert
  
  // Framework characteristics
  complexity        FrameworkComplexity       @default(MEDIUM)
  implementationTime String                   @db.VarChar(50) // "2-4 weeks"
  prerequisites     String[]                  // Required frameworks or capabilities
  dependencies      String[]                  // Framework IDs this depends on
  
  // Business value
  businessValue     String[]                  // Key benefits
  useCases          String[]                  // When to use this framework
  keyFeatures       String[]                  // Main features/components
  outcomes          String[]                  // Expected outcomes
  
  // Implementation details  
  methodology       Json?                     // Implementation methodology steps
  templates         Json?                     // Templates and tools
  assessments       Json?                     // Assessment criteria
  kpis              Json?                     // Key performance indicators
  
  // Metadata
  isActive          Boolean                   @default(true)
  isPublic          Boolean                   @default(true)
  isPremium         Boolean                   @default(false)
  popularity        Int                       @default(0)
  rating            Float                     @default(0.0)
  downloadCount     Int                       @default(0)
  
  // Audit fields
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  createdBy         String?
  updatedBy         String?
  
  // Relations
  createdByUser     User?                     @relation("FrameworkTemplateCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?                     @relation("FrameworkTemplateUpdatedBy", fields: [updatedBy], references: [id])
  
  // Framework relationships
  sourceRelationships    FrameworkRelationship[] @relation("SourceFramework")
  targetRelationships    FrameworkRelationship[] @relation("TargetFramework")
  
  // Organization implementations
  implementations   OrganizationFramework[]
  organizations     Organization[]
  
  // Analytics
  analytics         FrameworkAnalytics[]
  recommendations   FrameworkRecommendation[]

  @@index([frameworkId])
  @@index([category])
  @@index([domain])
  @@index([complexity])
  @@index([isActive])
  @@index([popularity])
  @@map("framework_templates")
}

model FrameworkRelationship {
  id                String                    @id @default(cuid())
  sourceFrameworkId String
  targetFrameworkId String
  relationshipType  FrameworkRelationshipType
  strength          Float                     @default(1.0) // 0.0 to 1.0
  description       String?                   @db.VarChar(500)
  
  // Bidirectional relationships
  isBidirectional   Boolean                   @default(false)
  
  // Metadata
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  
  // Relations
  sourceFramework   FrameworkTemplate         @relation("SourceFramework", fields: [sourceFrameworkId], references: [id], onDelete: Cascade)
  targetFramework   FrameworkTemplate         @relation("TargetFramework", fields: [targetFrameworkId], references: [id], onDelete: Cascade)
  
  @@unique([sourceFrameworkId, targetFrameworkId, relationshipType])
  @@index([sourceFrameworkId])
  @@index([targetFrameworkId])
  @@index([relationshipType])
  @@map("framework_relationships")
}

model OrganizationFramework {
  id                   String                        @id @default(cuid())
  organizationId       String
  frameworkTemplateId  String
  
  // Implementation details
  name                 String?                       @db.VarChar(255) // Custom name override
  status               FrameworkImplementationStatus @default(PLANNING)
  progress             Float                         @default(0.0) // 0.0 to 1.0
  maturityLevel        FrameworkMaturityLevel        @default(INITIAL)
  
  // Customization
  customizations       Json?                         // Organization-specific customizations
  configuration        Json?                         // Framework configuration
  assessmentResults    Json?                         // Latest assessment results
  
  // Scheduling
  startDate            DateTime?
  targetDate           DateTime?
  completionDate       DateTime?
  lastAssessmentDate   DateTime?
  nextAssessmentDate   DateTime?
  
  // Team assignment
  ownerId              String?                       // Framework owner
  teamMemberIds        String[]                      // Assigned team members
  
  // Metadata
  notes                String?                       @db.Text
  tags                 String[]
  priority             FrameworkPriority             @default(MEDIUM)
  
  // Audit fields
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  createdBy            String?
  updatedBy            String?
  
  // Relations
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  frameworkTemplate    FrameworkTemplate       @relation(fields: [frameworkTemplateId], references: [id], onDelete: Cascade)
  owner                User?                   @relation("FrameworkOwner", fields: [ownerId], references: [id])
  createdByUser        User?                   @relation("OrganizationFrameworkCreatedBy", fields: [createdBy], references: [id])
  updatedByUser        User?                   @relation("OrganizationFrameworkUpdatedBy", fields: [updatedBy], references: [id])
  
  // Implementation tracking
  assessments          FrameworkAssessment[]
  tasks                FrameworkTask[]
  milestones           FrameworkMilestone[]
  
  // Data storage for different visualization types
  tableData            FrameworkTableData[]
  kanbanBoards         KanbanBoard[]
  capabilityMaps       CapabilityMapData[]
  
  @@unique([organizationId, frameworkTemplateId])
  @@index([organizationId])
  @@index([frameworkTemplateId])
  @@index([status])
  @@index([priority])
  @@index([ownerId])
  @@map("organization_frameworks")
}

model FrameworkAssessment {
  id                        String                @id @default(cuid())
  organizationFrameworkId   String
  
  // Assessment details
  assessmentType            FrameworkAssessmentType @default(MATURITY)
  name                      String                @db.VarChar(255)
  description               String?               @db.Text
  
  // Results
  overallScore              Float                 @default(0.0) // 0.0 to 5.0
  maturityLevel             FrameworkMaturityLevel @default(INITIAL)
  results                   Json                  // Detailed assessment results
  recommendations           Json?                 // Improvement recommendations
  gaps                      Json?                 // Identified gaps
  strengths                 Json?                 // Identified strengths
  
  // Scheduling
  assessmentDate            DateTime              @default(now())
  nextAssessmentDate        DateTime?
  
  // Assessor details
  assessorId                String?
  assessorType              String?               @db.VarChar(50) // "internal", "external", "self"
  
  // Metadata
  status                    AssessmentStatus      @default(COMPLETED)
  isBaseline                Boolean               @default(false)
  
  // Audit fields
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  createdBy                 String?
  updatedBy                 String?
  
  // Relations
  organizationFramework     OrganizationFramework @relation(fields: [organizationFrameworkId], references: [id], onDelete: Cascade)
  assessor                  User?                 @relation("FrameworkAssessor", fields: [assessorId], references: [id])
  createdByUser             User?                 @relation("FrameworkAssessmentCreatedBy", fields: [createdBy], references: [id])
  updatedByUser             User?                 @relation("FrameworkAssessmentUpdatedBy", fields: [updatedBy], references: [id])
  
  @@index([organizationFrameworkId])
  @@index([assessmentType])
  @@index([assessmentDate])
  @@index([assessorId])
  @@map("framework_assessments")
}

model FrameworkTask {
  id                        String                @id @default(cuid())
  organizationFrameworkId   String
  
  // Task details
  title                     String                @db.VarChar(255)
  description               String?               @db.Text
  taskType                  FrameworkTaskType     @default(IMPLEMENTATION)
  
  // Status and progress
  status                    FrameworkTaskStatus   @default(PENDING)
  progress                  Float                 @default(0.0) // 0.0 to 1.0
  priority                  TaskPriority          @default(MEDIUM)
  
  // Scheduling
  startDate                 DateTime?
  dueDate                   DateTime?
  completionDate            DateTime?
  
  // Assignment
  assigneeId                String?
  estimatedHours            Float?
  actualHours               Float?
  
  // Dependencies
  dependsOnTaskIds          String[]              // Task IDs this depends on
  blockedByTaskIds          String[]              // Task IDs blocking this
  
  // Metadata
  tags                      String[]
  notes                     String?               @db.Text
  
  // Audit fields
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  createdBy                 String?
  updatedBy                 String?
  
  // Relations
  organizationFramework     OrganizationFramework @relation(fields: [organizationFrameworkId], references: [id], onDelete: Cascade)
  assignee                  User?                 @relation("FrameworkTaskAssignee", fields: [assigneeId], references: [id])
  createdByUser             User?                 @relation("FrameworkTaskCreatedBy", fields: [createdBy], references: [id])
  updatedByUser             User?                 @relation("FrameworkTaskUpdatedBy", fields: [updatedBy], references: [id])
  
  @@index([organizationFrameworkId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("framework_tasks")
}

model FrameworkMilestone {
  id                        String                @id @default(cuid())
  organizationFrameworkId   String
  
  // Milestone details
  name                      String                @db.VarChar(255)
  description               String?               @db.Text
  milestoneType             FrameworkMilestoneType @default(PHASE_COMPLETION)
  
  // Status and progress
  status                    FrameworkMilestoneStatus @default(PENDING)
  progress                  Float                 @default(0.0) // 0.0 to 1.0
  
  // Scheduling
  targetDate                DateTime
  actualDate                DateTime?
  
  // Success criteria
  successCriteria           Json?                 // Success criteria definition
  completionEvidence       Json?                 // Evidence of completion
  
  // Metadata
  isRequired                Boolean               @default(true)
  order                     Int                   @default(0)
  
  // Approval and completion
  approverId                String?
  completedById             String?
  
  // Audit fields
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  createdBy                 String?
  updatedBy                 String?
  
  // Relations
  organizationFramework     OrganizationFramework @relation(fields: [organizationFrameworkId], references: [id], onDelete: Cascade)
  createdByUser             User?                 @relation("FrameworkMilestoneCreatedBy", fields: [createdBy], references: [id])
  updatedByUser             User?                 @relation("FrameworkMilestoneUpdatedBy", fields: [updatedBy], references: [id])
  approver                  User?                 @relation("FrameworkMilestoneApprover", fields: [approverId], references: [id])
  completedBy               User?                 @relation("FrameworkMilestoneCompletedBy", fields: [completedById], references: [id])
  
  @@index([organizationFrameworkId])
  @@index([status])
  @@index([targetDate])
  @@index([order])
  @@map("framework_milestones")
}

model FrameworkAnalytics {
  id                 String            @id @default(cuid())
  frameworkTemplateId String
  organizationId     String?           // Null for global analytics
  
  // Usage metrics
  viewCount          Int               @default(0)
  downloadCount      Int               @default(0)
  implementationCount Int              @default(0)
  completionCount    Int               @default(0)
  
  // Performance metrics
  averageImplementationTime Float?     // In days
  averageCompletionRate     Float?     // 0.0 to 1.0
  averageSatisfactionScore  Float?     // 1.0 to 5.0
  
  // Time-based metrics
  period             AnalyticsPeriod   @default(MONTHLY)
  periodStart        DateTime
  periodEnd          DateTime
  
  // Metadata
  lastCalculated     DateTime          @default(now())
  
  // Relations
  frameworkTemplate  FrameworkTemplate @relation(fields: [frameworkTemplateId], references: [id], onDelete: Cascade)
  organization       Organization?     @relation("FrameworkAnalyticsOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@unique([frameworkTemplateId, organizationId, period, periodStart])
  @@index([frameworkTemplateId])
  @@index([organizationId])
  @@index([period])
  @@index([periodStart])
  @@map("framework_analytics")
}

model FrameworkRecommendation {
  id                 String               @id @default(cuid())
  organizationId     String
  frameworkTemplateId String
  
  // Recommendation details
  reason             String               @db.Text
  confidence         Float                @default(0.5) // 0.0 to 1.0
  priority           RecommendationPriority @default(MEDIUM)
  
  // Recommendation context
  triggerEvent       String?              @db.VarChar(100) // What triggered this recommendation
  contextData        Json?                // Additional context
  
  // User interaction
  status             RecommendationStatus @default(PENDING)
  userFeedback       Float?               // 1.0 to 5.0 stars
  userComments       String?              @db.Text
  
  // Scheduling
  recommendedDate    DateTime             @default(now())
  expiryDate         DateTime?
  respondedDate      DateTime?
  
  // Metadata
  algorithmVersion   String?              @db.VarChar(20)
  
  // Audit fields
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  
  // Relations
  organization       Organization         @relation("FrameworkRecommendationOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  frameworkTemplate  FrameworkTemplate    @relation(fields: [frameworkTemplateId], references: [id], onDelete: Cascade)
  viewers            User[]               @relation("FrameworkRecommendationViewer")
  
  @@unique([organizationId, frameworkTemplateId])
  @@index([organizationId])
  @@index([frameworkTemplateId])
  @@index([status])
  @@index([priority])
  @@index([recommendedDate])
  @@map("framework_recommendations")
}


  RISK
  POLICY
  FEATURE
  WORK_PACKAGE
}

model Relationship {
  id                String             @id @default(cuid())
  organizationId    String
  
  type              RelationshipType
  sourceEntityType  EntityType
  sourceEntityId    String
  targetEntityType  EntityType
  targetEntityId    String
  
  strength          Int                @default(50)
  confidence        Int                @default(100)
  bidirectional     Boolean            @default(false)
  
  description       String?            @db.Text
  tags              String[]
  properties        Json?
  
  validFrom         DateTime?
  validUntil        DateTime?
  
  source            RelationshipSource @default(MANUAL)
  verifiedBy        String?
  verifiedAt        DateTime?
  
  createdAt         DateTime           @default(now())
  createdBy         String
  updatedAt         DateTime           @updatedAt
  updatedBy         String?
  
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator           User               @relation("RelationshipCreator", fields: [createdBy], references: [id])
  updater           User?              @relation("RelationshipUpdater", fields: [updatedBy], references: [id])
  
  @@index([sourceEntityType, sourceEntityId])
  @@index([targetEntityType, targetEntityId])
  @@index([type])
  @@index([organizationId])
  @@index([source])
  @@map("relationships")
}

model Embedding {
  id             String   @id @default(cuid())
  organizationId String
  
  entityType     String   @db.VarChar(100)
  entityId       String
  
  model          String   @db.VarChar(100)

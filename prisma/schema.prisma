model Task {
  id             String    @id @default(cuid())
  organizationId String
  name           String    @db.VarChar(255)
  description    String?   @db.VarChar(2000)
  status         String    @default("todo") @db.VarChar(50)
  priority       String    @default("medium") @db.VarChar(50)
  assigneeId     String?
  sprintId       String?
  projectId      String?
  requirementId  String?
  storyPoints    Int?
  estimatedHours Decimal?  @db.Decimal(8, 2)
  actualHours    Decimal?  @db.Decimal(8, 2)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  tags           Json?
  metadata       Json?

  // Workflow-specific fields for compliance framework Kanban boards
  workflowId      String?                       // Reference to Workflow
  frameworkType   String?   @db.VarChar(100)   // HIPAA, SOC2, ISO27001, etc. (kept for backward compatibility)
  controlId       String?   @db.VarChar(255)   // Control identifier (e.g., "164.308(a)(1)(i)")
  workflowColumn  String?   @db.VarChar(50)    // backlog, planning, inProgress, review, completed
  columnPosition  Int?                          // Position within the column for ordering

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String
  updatedBy      String?  

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator      User         @relation("TaskCreator", fields: [createdBy], references: [id])
  updater      User?        @relation("TaskUpdater", fields: [updatedBy], references: [id])
  sprint       Sprint?      @relation(fields: [sprintId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  workflow     Workflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  comments     Comment[]

  @@index([organizationId], map: "IX_Task_organizationId")
  @@index([status], map: "IX_Task_status")
  @@index([priority], map: "IX_Task_priority")
  @@index([assigneeId], map: "IX_Task_assigneeId")
  @@index([sprintId], map: "IX_Task_sprintId")
  @@index([projectId], map: "IX_Task_projectId")
  @@index([workflowId], map: "IX_Task_workflowId")
  @@index([createdBy], map: "IX_Task_createdBy")
  @@index([frameworkType], map: "IX_Task_frameworkType")
  @@index([workflowColumn], map: "IX_Task_workflowColumn")
  @@index([organizationId, frameworkType, workflowColumn], map: "IX_Task_workflow_lookup")
  @@index([workflowId, workflowColumn, columnPosition], map: "IX_Task_workflow_kanban")
}

model Workflow {
  id             String    @id @default(cuid())
  organizationId String

  // Core workflow definition
  name           String    @db.VarChar(255)
  description    String?   @db.VarChar(2000)
  frameworkType  String    @db.VarChar(100)   // TOGAF, COBIT, PCF, HIPAA, SOC2, ISO27001, etc.
  segment        String    @db.VarChar(255)   // "ADM_PHASE_A", "EDM01", "Privacy_Rule", etc.
  segmentName    String?   @db.VarChar(255)   // Human-readable: "Architecture Vision", "Ensure Governance Framework", etc.

  // Flexible context - can belong to project, initiative, or organization-level
  projectId      String?
  initiativeId   String?

  // Workflow state
  status         String    @default("active") @db.VarChar(50)  // active, completed, archived, on_hold
  startDate      DateTime?
  targetDate     DateTime?
  completedAt    DateTime?

  // Progress tracking (cached for performance)
  totalTasks     Int       @default(0)
  completedTasks Int       @default(0)
  progressPercent Decimal? @db.Decimal(5, 2)

  // Metadata
  metadata       Json?     // Custom fields per framework (phases, dependencies, etc.)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String
  updatedBy      String?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  initiative     Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  tasks          Task[]
  creator        User         @relation("WorkflowCreator", fields: [createdBy], references: [id])
  updater        User?        @relation("WorkflowUpdater", fields: [updatedBy], references: [id])

  // Indexes
  @@index([organizationId], map: "IX_Workflow_organizationId")
  @@index([projectId], map: "IX_Workflow_projectId")
  @@index([initiativeId], map: "IX_Workflow_initiativeId")
  @@index([frameworkType], map: "IX_Workflow_frameworkType")
  @@index([segment], map: "IX_Workflow_segment")
  @@index([status], map: "IX_Workflow_status")
  @@index([organizationId, frameworkType], map: "IX_Workflow_org_framework")
  @@index([projectId, frameworkType, segment], map: "IX_Workflow_project_segment")
  @@unique([projectId, frameworkType, segment], map: "UQ_Workflow_project_framework_segment")
  @@unique([initiativeId, frameworkType, segment], map: "UQ_Workflow_initiative_framework_segment")
  @@map("workflows")
}

model Sprint {

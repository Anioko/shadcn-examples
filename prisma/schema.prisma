// ======================================================================
// BATCH 5: DIAGRAMMING SYSTEM (ArchiMate, ERD, UML, C4, BPMN)
// ======================================================================

enum NotationType {
  ARCHIMATE_3_2
  CHEN_ERD
  CROWS_FOOT_ERD
  UML_2_5
  C4_MODEL
  BPMN_2_0
}

model Diagram {
  id             String       @id @default(cuid())
  organizationId String
  
  name           String       @db.VarChar(255)
  description    String?      @db.Text
  
  type           DiagramType
  notation       NotationType
  
  layerId        String?
  viewpointId    String?
  
  layout         Json?
  style          Json?
  metadata       Json?
  
  version        Int          @default(1)
  isPublished    Boolean      @default(false)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String
  updatedBy      String?
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("DiagramCreator", fields: [createdBy], references: [id])
  updater        User?        @relation("DiagramUpdater", fields: [updatedBy], references: [id])
  layer          DiagramLayer? @relation(fields: [layerId], references: [id])
  nodes          DiagramNode[]
  edges          DiagramEdge[]
  views          DiagramView[]
  
  @@index([organizationId])
  @@index([type])
  @@index([createdBy])
  @@map("diagrams")
}

model DiagramLayer {
  id             String    @id @default(cuid())
  organizationId String
  
  name           String    @db.VarChar(100)
  description    String?   @db.Text
  
  layerType      String    @db.VarChar(50)
  color          String?   @db.VarChar(20)
  zIndex         Int       @default(0)
  
  metadata       Json?
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  diagrams       Diagram[]
  
  @@index([organizationId])
  @@map("diagram_layers")
}

model DiagramNode {
  id             String    @id @default(cuid())
  diagramId      String
  
  nodeType       String    @db.VarChar(100)
  elementId      String?
  elementType    String?   @db.VarChar(100)
  
  label          String    @db.VarChar(500)
  description    String?   @db.Text
  
  positionX      Float
  positionY      Float
  width          Float?
  height         Float?
  
  style          Json?
  properties     Json?
  metadata       Json?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  diagram        Diagram   @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  sourceEdges    DiagramEdge[] @relation("SourceNode")
  targetEdges    DiagramEdge[] @relation("TargetNode")
  
  @@index([diagramId])
  @@index([elementType, elementId])
  @@map("diagram_nodes")
}

model DiagramEdge {
  id             String    @id @default(cuid())
  diagramId      String
  
  sourceNodeId   String
  targetNodeId   String
  
  edgeType       String    @db.VarChar(100)
  relationshipId String?
  
  label          String?   @db.VarChar(255)
  
  style          Json?
  waypoints      Json?
  properties     Json?
  metadata       Json?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  diagram        Diagram      @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  sourceNode     DiagramNode  @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode     DiagramNode  @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)
  
  @@index([diagramId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("diagram_edges")
}

model DiagramView {
  id             String    @id @default(cuid())
  diagramId      String
  
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  
  viewpointType  String    @db.VarChar(100)
  
  visibleLayers  String[]
  hiddenElements String[]
  
  zoom           Float?    @default(1.0)
  panX           Float?    @default(0)
  panY           Float?    @default(0)
  
  isDefault      Boolean   @default(false)
  
  metadata       Json?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  diagram        Diagram   @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  
  @@index([diagramId])
  @@map("diagram_views")
}

model Notation {
  id             String    @id @default(cuid())
  
  name           String    @unique @db.VarChar(100)
  version        String    @db.VarChar(20)
  
  type           NotationType
  
  elementTypes   Json
  relationTypes  Json
  rules          Json?
  
  isActive       Boolean   @default(true)
  
  metadata       Json?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@map("notations")
}

// ======================================================================
// BATCH 6: ERD SPECIFIC MODELS
// ======================================================================

model ERDTable {
  id             String       @id @default(cuid())
  organizationId String
  diagramId      String?
  
  schemaName     String?      @db.VarChar(100)
  tableName      String       @db.VarChar(255)
  
  description    String?      @db.Text
  
  tableType      String       @default("TABLE") @db.VarChar(50)
  
  metadata       Json?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  columns        ERDColumn[]
  sourceRels     ERDRelationship[] @relation("SourceTable")
  targetRels     ERDRelationship[] @relation("TargetTable")
  
  @@unique([organizationId, schemaName, tableName])
  @@index([organizationId])
  @@map("erd_tables")
}

model ERDColumn {
  id             String    @id @default(cuid())
  tableId        String
  
  columnName     String    @db.VarChar(255)
  dataType       String    @db.VarChar(100)
  
  isPrimaryKey   Boolean   @default(false)
  isForeignKey   Boolean   @default(false)
  isNullable     Boolean   @default(true)
  isUnique       Boolean   @default(false)
  
  defaultValue   String?   @db.VarChar(255)
  
  length         Int?

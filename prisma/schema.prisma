model Risk {
  id             String       @id @default(cuid())
  organizationId String      
  title          String       @db.VarChar(255)
  description    String?      @db.Text
  category       RiskCategory
  type           RiskType     @default(THREAT)
  status         RiskStatus   @default(IDENTIFIED)

  // Risk assessment
  probability  RiskLevel @default(MEDIUM)
  impact       RiskLevel @default(MEDIUM)
  riskScore    Int       @default(0) // Calculated: probability * impact
  inherentRisk RiskLevel @default(MEDIUM)
  residualRisk RiskLevel @default(MEDIUM)

  // Context and details
  triggers      String[] // What could trigger this risk
  consequences  String[] // Potential outcomes
  affectedAreas String[] // Business areas affected

  // Ownership and responsibility
  ownerId   String? // Risk owner
  managerId String? // Risk manager

  // Timeline
  identifiedAt   DateTime  @default(now())
  reviewDate     DateTime? // Next review date
  escalationDate DateTime? // When to escalate if not mitigated

  // Monitoring
  kris           String[] // Key Risk Indicators
  monitoringFreq String?  @db.VarChar(50) // daily, weekly, monthly, quarterly

  // Audit fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String? 
  updatedBy     String? 
  versionNumber Int      @default(1)

  // Relations
  Organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Owner        User?            @relation("OwnedRisks", fields: [ownerId], references: [id])
  Manager      User?            @relation("ManagedRisks", fields: [managerId], references: [id])
  mitigations  RiskMitigation[]
  assessments  RiskAssessment[]

  @@index([organizationId], map: "IX_Risk_organizationId")
  @@index([category], map: "IX_Risk_category")
  @@index([status], map: "IX_Risk_status")
  @@index([riskScore], map: "IX_Risk_riskScore")
  @@index([ownerId], map: "IX_Risk_ownerId")
  @@index([reviewDate], map: "IX_Risk_reviewDate")
  @@map("risks")
}

model RiskAssessment {

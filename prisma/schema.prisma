  status                           String       @default("planned") @db.VarChar(50)
  priority                         String       @default("medium") @db.VarChar(50)
  dueDate                          DateTime?
  completionDate                   DateTime?
  estimatedEffort                  Int?
  actualEffort                     Int?
  quality                          String?      @db.VarChar(50)
  acceptanceCriteria               Json?
  dependencies                     Json?
  stakeholders                     Json?
  reviewers                        Json?
  approvers                        Json?
  artifacts                        Json?
  location                         String?      @db.VarChar(500)
  version                          String?      @db.VarChar(50)
  size                             String?      @db.VarChar(100)
  format                           String?      @db.VarChar(100)
  template                         String?      @db.VarChar(255)
  standards                        String?      @db.VarChar(500)
  checklist                        Json?
  risks                            Json?
  issues                           Json?
  feedback                         Json?
  metrics                          Json?
  owner                            String?      @db.VarChar(255)
  assignee                         String?      @db.VarChar(255)
  team                             Json?

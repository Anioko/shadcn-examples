model Strategy {
  id             String        @id @default(cuid())
  organizationId String       
  visionId       String?
  title          String        @db.VarChar(500)
  description    String
  strategyType   StrategyType  @default(BUSINESS)
  strategyLevel  StrategyLevel @default(CORPORATE)

  // Strategic content
  objectives           String[] // Array of strategic objectives
  initiatives          String[] // Array of key initiatives
  successMetrics       String[] // Array of success metrics
  competitiveAdvantage String?  @db.VarChar(2000)
  riskMitigation       String?  @db.VarChar(2000)

  // Implementation details
  implementationPlan   String?  @db.VarChar(5000)
  resourceRequirements String?  @db.VarChar(2000)
  timeline             String?  @db.VarChar(1000)
  budget               Decimal? @db.Decimal(15, 2)

  // Status and governance
  status        StrategyStatus   @default(DRAFT)
  priority      StrategyPriority @default(MEDIUM)
  approvalLevel ApprovalLevel    @default(PENDING)
  version       String           @default("1.0") @db.VarChar(20)

  // Dates
  startDate     DateTime?
  endDate       DateTime?
  reviewDate    DateTime?
  effectiveDate DateTime?

  // Governance
  ownerId      String?
  approvedById String?
  sponsorId    String?

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? 

  // Relations
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vision        Vision?      @relation(fields: [visionId], references: [id])
  owner         User?        @relation("StrategyOwner", fields: [ownerId], references: [id])
  approvedBy    User?        @relation("StrategyApprover", fields: [approvedById], references: [id])
  sponsor       User?        @relation("StrategySponsor", fields: [sponsorId], references: [id])
  createdByUser User?        @relation("StrategyCreator", fields: [createdBy], references: [id])

  // Child relations
  strategicGoals  StrategicGoal[]
  strategyMetrics StrategyMetric[]
  strategyReviews StrategyReview[]
  stakeholders    StrategyStakeholder[]

  @@index([organizationId])
  @@index([visionId])
  @@index([status])
  @@index([strategyType])
  @@index([priority])
  @@index([ownerId])
  @@map("strategies")
}

model Vision {
  id             String      @id @default(cuid())
  organizationId String     
  title          String      @db.VarChar(500)
  description    String
  visionType     VisionType  @default(CORPORATE)
  scope          VisionScope @default(ENTERPRISE)
  timeHorizon    String      @db.VarChar(50) // e.g., "5 years", "2030", "long-term"

  // Content structure
  inspirationalStatement String   @db.VarChar(2000)
  coreValues             String[] // Array of core values
  aspirationalGoals      String[] // Array of aspirational goals
  futureStateDescriptor  String?  @db.VarChar(2000)

  // Status and workflow
  status         VisionStatus  @default(DRAFT)
  approvalLevel  ApprovalLevel @default(PENDING)
  version        String        @default("1.0") @db.VarChar(20)
  effectiveDate  DateTime?
  expirationDate DateTime?

  // Governance
  ownerId      String?
  approvedById String?
  reviewerId   String?

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? 

  // Relations
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?        @relation("VisionOwner", fields: [ownerId], references: [id])
  approvedBy    User?        @relation("VisionApprover", fields: [approvedById], references: [id])
  reviewer      User?        @relation("VisionReviewer", fields: [reviewerId], references: [id])
  createdByUser User?        @relation("VisionCreator", fields: [createdBy], references: [id])

  // Child relations
  strategies    Strategy[]
  visionMetrics VisionMetric[]
  stakeholders  VisionStakeholder[]

  @@index([organizationId])
  @@index([status])
  @@index([visionType])
  @@index([ownerId])
  @@map("visions")
}

model StrategyMetric {
  id          String     @id @default(cuid())
  strategyId  String
  title       String     @db.VarChar(300)
  description String?    @db.VarChar(1000)
  metricType  MetricType @default(KPI)
  category    String     @db.VarChar(100)

  // Measurement details
  currentValue    String? @db.VarChar(200)
  targetValue     String  @db.VarChar(200)
  measurementUnit String? @db.VarChar(100)
  frequency       String  @db.VarChar(50)

  // Status
  status MetricStatus @default(ACTIVE)

  // Governance
  ownerId String?

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  owner    User?    @relation("StrategyMetricOwner", fields: [ownerId], references: [id])

  @@index([strategyId])
  @@index([status])
  @@index([metricType])
  @@map("strategy_metrics")
}

model StrategyReview {
  id         String             @id @default(cuid())
  strategyId String
  reviewType StrategyReviewType @default(QUARTERLY)
  reviewDate DateTime

  // Review content
  title           String   @db.VarChar(300)
  summary         String
  findings        String[] // Array of key findings
  recommendations String[] // Array of recommendations

  // Assessment
  overallRating  Int? // 1-5 rating
  progressRating Int? // 1-5 rating
  riskRating     Int? // 1-5 rating

  // Decisions and actions
  decisions      String[] // Array of decisions made
  actionItems    String[] // Array of action items
  nextReviewDate DateTime?

  // Governance

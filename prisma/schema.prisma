enum FrameworkDomain {
  STRATEGIC
  OPERATIONAL
  TACTICAL
  GOVERNANCE
  TECHNICAL
  BEHAVIORAL
  ANALYTICAL
  REGULATORY
  INNOVATION
  TRANSFORMATION
}

enum FrameworkComplexity {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum FrameworkRelationshipType {
  // Hierarchical relationships
  EXTENDS             // Framework B extends Framework A
  SPECIALIZES         // Framework B is a specialization of Framework A
  GENERALIZES         // Framework B generalizes Framework A
  
  // Complementary relationships  
  COMPLEMENTS         // Frameworks work well together
  INTEGRATES_WITH     // Can be integrated with
  SUPPORTS            // Framework A supports Framework B
  ENABLES             // Framework A enables Framework B
  
  // Dependency relationships
  REQUIRES            // Framework A requires Framework B
  DEPENDS_ON          // Framework A depends on Framework B
  PREREQUISITE        // Framework B is prerequisite for Framework A
  
  // Competitive relationships
  ALTERNATIVE_TO      // Alternative approach to same problem
  COMPETES_WITH       // Competing frameworks
  REPLACES            // Framework A replaces Framework B
  
  // Temporal relationships
  PRECEDES            // Framework A comes before Framework B
  FOLLOWS             // Framework A follows Framework B
  EVOLVES_INTO        // Framework A evolves into Framework B
  
  // Functional relationships
  MAPS_TO             // Framework A maps to Framework B
  OVERLAPS_WITH       // Frameworks have overlapping scope
  CONFLICTS_WITH      // Frameworks conflict with each other
  
  // Usage relationships
  USED_WITH           // Commonly used together
  RECOMMENDED_WITH    // Recommended to use together
  COMBINES_WITH       // Can be combined with
}

enum FrameworkMaturityLevel {
  INITIAL
  DEVELOPING
  DEFINED
  MANAGED
  OPTIMIZED
}

// FrameworkPriority already exists above, using that one

enum FrameworkAssessmentType {
  MATURITY
  CAPABILITY
  READINESS
  COMPLIANCE
  EFFECTIVENESS
  BENCHMARKING
  GAP_ANALYSIS

  businessOwnerUser                 User?                               @relation("ApplicationComponent_businessOwnerToUser", fields: [businessOwnerId], references: [id])
  itOwnerUser                       User?                               @relation("ApplicationComponent_itOwnerToUser", fields: [itOwnerId], references: [id])
  ApplicationComponentCollaboration ApplicationComponentCollaboration[]
  ApplicationComponentInteraction   ApplicationComponentInteraction[]
  ApplicationEvent                  ApplicationEvent[]
  ApplicationFunction               ApplicationFunction[]
  ApplicationInterface_providedBy   ApplicationInterface[]              @relation("ApplicationInterface_providedByComponentIdToApplicationComponent")
  ApplicationInterface_requiredBy   ApplicationInterface[]              @relation("ApplicationInterface_requiredByComponentIdToApplicationComponent")

  lastSyncAt     DateTime?
  syncFrequency  String?   @db.VarChar(50)
  isActive       Boolean   @default(true)
  errorCount     Int       @default(0)
  lastError      String?   @db.VarChar(1000)
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String   

  user                User                 @relation("Integration_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  IntegrationAccounts IntegrationAccount[]
  Connectors          Connector[]

  @@index([isActive], map: "IX_Integration_isActive")
  @@index([organizationId], map: "IX_Integration_organizationId")
  @@index([provider], map: "IX_Integration_provider")
  @@index([status], map: "IX_Integration_status")
  @@index([type], map: "IX_Integration_type")
}

model IntegrationAccount {
  id             String    @id
  organizationId String   
  integrationId  String    @db.VarChar(30)
  name           String    @db.VarChar(255)
  accountType    String    @db.VarChar(100)
  credentials    Json
  config         Json?
  status         String    @default("active") @db.VarChar(50)
  lastSyncAt     DateTime?
  syncEnabled    Boolean   @default(true)
  metadata       Json?
  tags           Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String   
  updatedBy      String?  

  integration   Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User         @relation("IntegrationAccount_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedByUser User?        @relation("IntegrationAccount_updatedByToUser", fields: [updatedBy], references: [id])
  Mappings      Mapping[]

  @@index([organizationId], map: "IX_IntegrationAccount_organizationId")
  @@index([integrationId], map: "IX_IntegrationAccount_integrationId")
  @@index([status], map: "IX_IntegrationAccount_status")
  @@index([createdBy], map: "IX_IntegrationAccount_createdBy")
  @@index([updatedBy], map: "IX_IntegrationAccount_updatedBy")
}

model Connector {
  id             String    @id
  organizationId String   
  integrationId  String    @db.VarChar(30)
  name           String    @db.VarChar(255)
  description    String?   @db.VarChar(2000)
  connectorType  String    @db.VarChar(100)
  direction      String    @default("bidirectional") @db.VarChar(50)
  config         Json
  authentication Json?
  endpoints      Json?
  rateLimits     Json?
  timeout        Int?
  retryPolicy    Json?
  status         String    @default("active") @db.VarChar(50)
  isEnabled      Boolean   @default(true)
  lastUsedAt     DateTime?
  usageCount     Int       @default(0)
  metadata       Json?
  tags           Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String   
  updatedBy      String?  

  integration     Integration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser   User             @relation("Connector_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedByUser   User?            @relation("Connector_updatedByToUser", fields: [updatedBy], references: [id])
  Mappings        Mapping[]
  Transformations Transformation[]

  @@index([organizationId], map: "IX_Connector_organizationId")
  @@index([integrationId], map: "IX_Connector_integrationId")
  @@index([connectorType], map: "IX_Connector_connectorType")
  @@index([status], map: "IX_Connector_status")
  @@index([createdBy], map: "IX_Connector_createdBy")
  @@index([updatedBy], map: "IX_Connector_updatedBy")
}

model IntegrationEndpoint {
  id                  String    @id
  organizationId      String   
  externalSystemId    String   
  name                String    @db.VarChar(255)
  description         String?   @db.VarChar(2000)
  type                String    @default("inbound") @db.VarChar(50)
  protocol            String    @default("rest") @db.VarChar(50)
  method              String    @default("GET") @db.VarChar(20)
  url                 String    @db.VarChar(2000)
  headers             Json?
  queryParams         Json?
  requestFormat       String    @default("json") @db.VarChar(50)
  responseFormat      String    @default("json") @db.VarChar(50)
  authentication      Json?
  rateLimiting        Json?
  timeout             Int?
  retryPolicy         Json?
  validation          Json?
  monitoring          Json?
  status              String    @default("inactive") @db.VarChar(50)
  lastUsed            DateTime?
  successRate         Decimal?  @db.Decimal(5, 4)
  averageResponseTime Int?
  metadata            Json?
  tags                Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String   
  updatedBy           String?  

  DataMapping    DataMapping[]
  createdByUser  User           @relation("IntegrationEndpoint_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  externalSystem ExternalSystem @relation(fields: [externalSystemId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser  User?          @relation("IntegrationEndpoint_updatedByToUser", fields: [updatedBy], references: [id])
  SyncJob        SyncJob[]

  @@index([createdBy], map: "IX_IntegrationEndpoint_createdBy")
  @@index([externalSystemId], map: "IX_IntegrationEndpoint_externalSystemId")
  @@index([organizationId], map: "IX_IntegrationEndpoint_organizationId")
  @@index([protocol], map: "IX_IntegrationEndpoint_protocol")
  @@index([status], map: "IX_IntegrationEndpoint_status")
  @@index([type], map: "IX_IntegrationEndpoint_type")
  @@index([updatedBy], map: "IX_IntegrationEndpoint_updatedBy")
}

model Mapping {
  id                   String    @id
  organizationId       String   
  integrationAccountId String   
  connectorId          String   
  name                 String    @db.VarChar(255)
  description          String?   @db.VarChar(2000)
  sourceEntity         String    @db.VarChar(255)
  targetEntity         String    @db.VarChar(255)
  direction            String    @default("inbound") @db.VarChar(50)
  mappingRules         Json
  transformationLogic  String?   @db.VarChar(4000)
  validation           Json?
  priority             Int       @default(0)
  isActive             Boolean   @default(true)
  lastExecutedAt       DateTime?
  executionCount       Int       @default(0)
  successCount         Int       @default(0)
  errorCount           Int       @default(0)
  metadata             Json?
  tags                 Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String   
  updatedBy            String?  

  connector          Connector          @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  integrationAccount IntegrationAccount @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser      User               @relation("Mapping_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedByUser      User?              @relation("Mapping_updatedByToUser", fields: [updatedBy], references: [id])

  @@index([organizationId], map: "IX_Mapping_organizationId")
  @@index([connectorId], map: "IX_Mapping_connectorId")
  @@index([integrationAccountId], map: "IX_Mapping_integrationAccountId")
  @@index([direction], map: "IX_Mapping_direction")
  @@index([isActive], map: "IX_Mapping_isActive")
  @@index([createdBy], map: "IX_Mapping_createdBy")
  @@index([updatedBy], map: "IX_Mapping_updatedBy")
}

model Transformation {
  id             String   @id
  organizationId String  
  connectorId    String  
  name           String   @db.VarChar(255)
  description    String?  @db.VarChar(2000)
  type           String   @db.VarChar(100)
  inputFormat    String   @db.VarChar(50)
  outputFormat   String   @db.VarChar(50)
  transformLogic String   @db.VarChar(4000)
  parameters     Json?
  isActive       Boolean  @default(true)
  executionOrder Int      @default(0)
  metadata       Json?
  tags           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String  
  updatedBy      String? 

  connector     Connector    @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User         @relation("Transformation_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedByUser User?        @relation("Transformation_updatedByToUser", fields: [updatedBy], references: [id])

  @@index([organizationId], map: "IX_Transformation_organizationId")
  @@index([connectorId], map: "IX_Transformation_connectorId")
  @@index([type], map: "IX_Transformation_type")
  @@index([isActive], map: "IX_Transformation_isActive")
  @@index([createdBy], map: "IX_Transformation_createdBy")
  @@index([updatedBy], map: "IX_Transformation_updatedBy")
}

// ---- Phase 12: Assessment, Security & Financial Management ---- //

model Assessment {
  id                              String         @id
  organizationId                  String        
  name                            String         @db.VarChar(255)
  type                            AssessmentType @default(swot)
  category                        String         @db.VarChar(100)
  description                     String?        @db.VarChar(2000)
  purpose                         String?        @db.VarChar(1000)
  scope                           String?        @db.VarChar(1000)
  methodology                     String?        @db.VarChar(500)
  criteria                        Json?
  findings                        Json?
  recommendations                 Json?
  strengths                       Json?
  weaknesses                      Json?
  opportunities                   Json?
  threats                         Json?
  risks                           Json?
  mitigations                     Json?
  assumptions                     String?        @db.VarChar(2000)
  limitations                     String?        @db.VarChar(1000)
  confidence                      String         @default("medium") @db.VarChar(20)
  status                          String         @default("draft") @db.VarChar(50)
  reviewDate                      DateTime?
  validUntil                      DateTime?
  participants                    Json?
  reviewers                       Json?
  approvers                       Json?
  priority                        String         @default("medium") @db.VarChar(20)
  businessImpact                  String?        @db.VarChar(2000)
  actionItems                     Json?
  tags                            Json?
  metadata                        Json?
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime
  createdBy                       String        
  updatedBy                       String?       
  User_Assessment_createdByToUser User           @relation("Assessment_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  Organization                    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User_Assessment_updatedByToUser User?          @relation("Assessment_updatedByToUser", fields: [updatedBy], references: [id])

  @@index([category])
  @@index([createdBy])
  @@index([organizationId])
  @@index([reviewDate])
  @@index([status])
  @@index([type])
  @@index([updatedBy])
}

model ComplianceReport {
  id              String           @id
  organizationId  String          
  name            String           @db.VarChar(255)
  description     String?          @db.VarChar(2000)
  reportType      String           @db.VarChar(100)
  status          ComplianceStatus @default(pending)
  reportDate      DateTime
  period          String?          @db.VarChar(100)
  findings        Json?
  recommendations Json?
  score           Int?
  owner           String?          @db.VarChar(255)
  reviewer        String?          @db.VarChar(255)
  tags            String?          @db.VarChar(500)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  createdBy       String          
  updatedBy       String?         
  Organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  CreatedByUser   User             @relation("ComplianceReport_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  UpdatedByUser   User?            @relation("ComplianceReport_updatedByToUser", fields: [updatedBy], references: [id])

  @@index([organizationId], map: "IX_ComplianceReport_organizationId")
  @@index([reportType], map: "IX_ComplianceReport_reportType")
  @@index([status], map: "IX_ComplianceReport_status")
  @@index([createdBy], map: "IX_ComplianceReport_createdBy")
  @@index([updatedBy], map: "IX_ComplianceReport_updatedBy")
}

model ComplianceAssessment {
  id          String @id @default(cuid())
  frameworkId String

  name           String                @db.VarChar(255)
  description    String?
  assessmentDate DateTime              @default(now())
  assessor       String                @db.VarChar(255)
  methodology    AssessmentMethodology
  scope          String[] // Areas or controls assessed

  // Results
  overallScore  Int              @default(0) // 0-100
  maturityLevel MaturityLevel    @default(PARTIAL)
  status        AssessmentStatus @default(PLANNED)

  // Scheduling
  nextAssessmentDate DateTime?

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? 
  updatedBy String? 

  SecurityFramework SecurityFramework          @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  CreatedByUser     User?                      @relation(fields: [createdBy], references: [id])
  results           AssessmentResult[]
  recommendations   AssessmentRecommendation[]
  Organization      Organization?              @relation(fields: [organizationId], references: [id])
  organizationId    String?                   

  @@index([frameworkId], map: "IX_ComplianceAssessment_frameworkId")
  @@index([assessmentDate], map: "IX_ComplianceAssessment_assessmentDate")
  @@index([status], map: "IX_ComplianceAssessment_status")
  @@map("compliance_assessments")
}

model AssessmentResult {
  id           String @id @default(cuid())
  assessmentId String
  controlId    String

  // Results
  score               Int                 @default(0) // 0-100
  implementationLevel ImplementationLevel @default(NOT_IMPLEMENTED)
  testOutcome         TestOutcome         @default(NOT_TESTED)

  // Analysis
  gaps      String[] // Identified gaps
  strengths String[] // Identified strengths
  notes     String?

  // Audit fields
  createdAt DateTime @default(now())

  ComplianceAssessment ComplianceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, controlId])
  @@index([assessmentId], map: "IX_AssessmentResult_assessmentId")
  @@map("assessment_results")
}

model AssessmentRecommendation {
  id           String @id @default(cuid())
  assessmentId String

  priority    SecurityTaskPriority
  category    String               @db.VarChar(100)
  title       String               @db.VarChar(500)
  description String
  benefits    String[]

  // Implementation details
  effort   String? // minimal, moderate, significant, extensive
  cost     Int? // estimated cost
  timeline String? // estimated timeline

  // Dependencies and references
  dependencies      String[]
  relatedControlIds String[]

  // Status tracking
  status        String    @default("proposed") @db.VarChar(50)
  implementedAt DateTime?

  // Audit fields
  createdAt DateTime @default(now())

  ComplianceAssessment ComplianceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId], map: "IX_AssessmentRecommendation_assessmentId")
  @@index([priority], map: "IX_AssessmentRecommendation_priority")
  @@map("assessment_recommendations")
}

model SecurityFramework {
  id             String                @id @default(cuid())
  organizationId String               
  name           String                @db.VarChar(255)
  frameworkType  SecurityFrameworkType
  version        FrameworkVersion?
  description    String?

  // Implementation details
  implementationStatus ImplementationStatus @default(PLANNING)
  maturityLevel        MaturityLevel        @default(PARTIAL)
  overallScore         Int                  @default(0)

  // Scheduling
  implementationDate DateTime?
  lastReviewDate     DateTime?
  nextReviewDate     DateTime?

  // Audit fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String? 
  updatedBy     String? 
  versionNumber Int      @default(1)

  Organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controls          SecurityControl[]
  assessments       ComplianceAssessment[]
  tasks             SecurityTask[]
  frameworkMappings FrameworkControlMapping[] @relation("SourceFramework")
  targetMappings    FrameworkControlMapping[] @relation("TargetFramework")

  @@index([organizationId], map: "IX_SecurityFramework_organizationId")
  @@index([frameworkType], map: "IX_SecurityFramework_frameworkType")
  @@index([implementationStatus], map: "IX_SecurityFramework_implementationStatus")
  @@map("security_frameworks")
}

model SecurityControl {
  id          String  @id @default(cuid())
  frameworkId String 
  controlId   String  @db.VarChar(50) // e.g., "AC-1", "ID.AM-1"
  name        String  @db.VarChar(500)
  description String?

  // Control classification
  family       ControlFamily?
  nistFunction NISTFunction?
  baseline     String[] // low, moderate, high, privacy

  // Implementation details
  implementationStatus ImplementationLevel @default(NOT_IMPLEMENTED)
  implementationNotes  String?

  // Testing details
  testStatus   TestOutcome @default(NOT_TESTED)
  lastTested   DateTime?
  nextTestDate DateTime?
  testMethod   TestMethod?

  // Ownership
  responsibleUserId String?
  reviewerUserId    String?

  // Priority and risk
  priority  SecurityTaskPriority @default(MEDIUM)
  riskLevel RiskLevel            @default(MEDIUM)

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? 
  updatedBy String? 

  SecurityFramework SecurityFramework   @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  ResponsibleUser   User?               @relation("ResponsibleControls", fields: [responsibleUserId], references: [id])
  ReviewerUser      User?               @relation("ReviewedControls", fields: [reviewerUserId], references: [id])
  testResults       ControlTestResult[]
  evidence          SecurityEvidence[]
  tasks             SecurityTask[]
  findings          SecurityFinding[]
  Organization      Organization?       @relation(fields: [organizationId], references: [id])
  organizationId    String?            

  @@unique([frameworkId, controlId])
  @@index([frameworkId], map: "IX_SecurityControl_frameworkId")
  @@index([implementationStatus], map: "IX_SecurityControl_implementationStatus")
  @@index([responsibleUserId], map: "IX_SecurityControl_responsibleUserId")
  @@index([priority], map: "IX_SecurityControl_priority")
  @@map("security_controls")
}

model ControlTestResult {
  id        String @id @default(cuid())
  controlId String

  testDate        DateTime
  testMethod      TestMethod
  result          TestOutcome
  findings        String?
  recommendations String?

  // Testing details
  testerId     String?
  testDuration Int? // minutes
  testEvidence String? // file paths or references

  // Audit fields
  createdAt DateTime @default(now())
  createdBy String? 

  SecurityControl  SecurityControl   @relation(fields: [controlId], references: [id], onDelete: Cascade)
  Tester           User?             @relation(fields: [testerId], references: [id])
  securityFindings SecurityFinding[]

  @@index([controlId], map: "IX_ControlTestResult_controlId")
  @@index([testDate], map: "IX_ControlTestResult_testDate")
  @@map("control_test_results")
}

model SecurityEvidence {
  id        String  @id @default(cuid())
  controlId String 
  taskId    String?

  title       String       @db.VarChar(255)
  description String?
  type        EvidenceType

  // File details
  filePath String? @db.VarChar(500)
  url      String? @db.VarChar(500)
  fileSize BigInt?
  mimeType String? @db.VarChar(100)

  // Evidence lifecycle
  collectedDate DateTime  @default(now())
  collectorId   String?  
  validUntil    DateTime?

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  SecurityControl SecurityControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  SecurityTask    SecurityTask?   @relation(fields: [taskId], references: [id])
  Collector       User?           @relation(fields: [collectorId], references: [id])

  @@index([controlId], map: "IX_SecurityEvidence_controlId")
  @@index([type], map: "IX_SecurityEvidence_type")
  @@index([collectedDate], map: "IX_SecurityEvidence_collectedDate")
  @@map("security_evidence")
}

model SecurityTask {
  id          String  @id @default(cuid())
  frameworkId String 
  controlId   String?

  title       String  @db.VarChar(500)
  description String?

  // Task classification
  priority  SecurityTaskPriority @default(MEDIUM)
  status    SecurityTaskStatus   @default(TODO)
  category  SecurityTaskCategory
  riskLevel RiskLevel            @default(MEDIUM)

  // Assignment and scheduling
  assignedToId String?  
  dueDate      DateTime?
  startDate    DateTime?
  completedAt  DateTime?

  // Progress tracking
  progress       Int  @default(0) // 0-100
  estimatedHours Int?
  actualHours    Int?

  // Metadata
  tags       String[]
  externalId String?  @db.VarChar(100) // Integration with external tools

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? 
  updatedBy String? 

  SecurityFramework SecurityFramework  @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  SecurityControl   SecurityControl?   @relation(fields: [controlId], references: [id])
  AssignedTo        User?              @relation("AssignedSecurityTasks", fields: [assignedToId], references: [id])
  CreatedByUser     User?              @relation("CreatedSecurityTasks", fields: [createdBy], references: [id])
  evidence          SecurityEvidence[]
  Organization      Organization?      @relation(fields: [organizationId], references: [id])
  organizationId    String?           

  @@index([frameworkId], map: "IX_SecurityTask_frameworkId")
  @@index([controlId], map: "IX_SecurityTask_controlId")
  @@index([assignedToId], map: "IX_SecurityTask_assignedToId")
  @@index([status], map: "IX_SecurityTask_status")
  @@index([dueDate], map: "IX_SecurityTask_dueDate")
  @@index([category], map: "IX_SecurityTask_category")
  @@map("security_tasks")
}

model SecurityFinding {
  id           String  @id @default(cuid())
  controlId    String 
  testResultId String?

  severity    FindingSeverity
  title       String          @db.VarChar(500)
  description String
  remediation String

  // Tracking
  status           FindingStatus @default(OPEN)
  dueDate          DateTime?
  assigneeId       String?      
  verificationDate DateTime?

  // Risk assessment
  riskLevel      RiskLevel @default(MEDIUM)
  businessImpact String?

  // References
  externalRef String? @db.VarChar(100)
  cweId       String? @db.VarChar(20) // Common Weakness Enumeration
  cveId       String? @db.VarChar(20) // Common Vulnerabilities and Exposures

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? 

  SecurityControl   SecurityControl    @relation(fields: [controlId], references: [id], onDelete: Cascade)
  ControlTestResult ControlTestResult? @relation(fields: [testResultId], references: [id])
  Assignee          User?              @relation("AssignedFindings", fields: [assigneeId], references: [id])
  CreatedByUser     User?              @relation("CreatedFindings", fields: [createdBy], references: [id])
  Organization      Organization?      @relation(fields: [organizationId], references: [id])
  organizationId    String?           

  @@index([controlId], map: "IX_SecurityFinding_controlId")
  @@index([severity], map: "IX_SecurityFinding_severity")
  @@index([status], map: "IX_SecurityFinding_status")
  @@index([assigneeId], map: "IX_SecurityFinding_assigneeId")
  @@map("security_findings")
}

model FrameworkControlMapping {
  id String @id @default(cuid())

  sourceFrameworkId String
  sourceControlId   String @db.VarChar(50)
  targetFrameworkId String
  targetControlId   String @db.VarChar(50)

  mappingType String  @default("related") @db.VarChar(20) // exact, partial, related, informative
  confidence  Decimal @default(0.8) @db.Decimal(3, 2)
  notes       String?

  // Audit fields
  createdAt DateTime @default(now())
  createdBy String? 

  SourceFramework SecurityFramework @relation("SourceFramework", fields: [sourceFrameworkId], references: [id], onDelete: Cascade)
  TargetFramework SecurityFramework @relation("TargetFramework", fields: [targetFrameworkId], references: [id], onDelete: Cascade)
  CreatedByUser   User?             @relation(fields: [createdBy], references: [id])

  @@unique([sourceFrameworkId, sourceControlId, targetFrameworkId, targetControlId])
  @@index([sourceFrameworkId], map: "IX_FrameworkControlMapping_sourceFrameworkId")
  @@index([targetFrameworkId], map: "IX_FrameworkControlMapping_targetFrameworkId")
  @@map("framework_control_mappings")
}

model FinancialBudget {
  id              String       @id @default(cuid())
  organizationId  String      
  name            String       @db.VarChar(255)
  description     String?      @db.VarChar(2000)
  fiscalYear      Int
  startDate       DateTime
  endDate         DateTime
  totalAmount     Decimal      @db.Decimal(15, 2)
  spentAmount     Decimal      @default(0) @db.Decimal(15, 2)
  remainingAmount Decimal      @db.Decimal(15, 2)
  currency        String       @default("USD") @db.VarChar(3)
  status          BudgetStatus @default(active)
  budgetType      String       @default("operational") @db.VarChar(50)
  approvalStatus  String       @default("pending") @db.VarChar(50)
  approvedBy      String?     
  approvedAt      DateTime?
  notes           String?      @db.VarChar(4000)
  tags            Json?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       String?     
  updatedBy       String?     

  // Relations
  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems    FinancialBudgetLineItem[]
  allocations  FinancialBudgetAllocation[]
  forecasts    FinancialBudgetForecast[]

  @@index([organizationId])
  @@index([fiscalYear, organizationId])
  @@index([status])
}

model FinancialBudgetLineItem {
  id              String   @id @default(cuid())
  budgetId        String
  category        String   @db.VarChar(255)
  subcategory     String?  @db.VarChar(255)
  description     String?  @db.VarChar(1000)
  plannedAmount   Decimal  @db.Decimal(15, 2)
  spentAmount     Decimal  @default(0) @db.Decimal(15, 2)
  remainingAmount Decimal  @db.Decimal(15, 2)
  percentage      Decimal? @db.Decimal(5, 2)
  notes           String?  @db.VarChar(1000)
  isLocked        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  budget FinancialBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([category])
}

model FinancialBudgetAllocation {
  id              String   @id @default(cuid())
  budgetId        String
  departmentId    String? 
  projectId       String? 
  userId          String? 
  allocationType  String   @db.VarChar(100)
  allocatedAmount Decimal  @db.Decimal(15, 2)
  spentAmount     Decimal  @default(0) @db.Decimal(15, 2)
  remainingAmount Decimal  @db.Decimal(15, 2)
  startDate       DateTime
  endDate         DateTime
  status          String   @default("active") @db.VarChar(50)
  notes           String?  @db.VarChar(1000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  budget FinancialBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([allocationType])
  @@index([status])
}

model FinancialBudgetForecast {
  id              String   @id @default(cuid())
  budgetId        String
  period          String   @db.VarChar(50)
  forecastDate    DateTime
  forecastAmount  Decimal  @db.Decimal(15, 2)
  actualAmount    Decimal? @db.Decimal(15, 2)
  variance        Decimal? @db.Decimal(15, 2)
  variancePercent Decimal? @db.Decimal(5, 2)
  confidence      String   @default("medium") @db.VarChar(20)
  methodology     String?  @db.VarChar(255)
  assumptions     String?  @db.VarChar(2000)
  notes           String?  @db.VarChar(1000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  budget FinancialBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([period])
  @@index([forecastDate])
}

model InfrastructureMonitoring {
  id             String @id @default(cuid())
  organizationId String
  assetId        String
  assetType      String @db.VarChar(50) // Node, Device, Service

  metricName   String  @db.VarChar(100)
  metricValue  Float
  threshold    Float?
  alertEnabled Boolean @default(true)

  timestamp DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assetId, assetType])
  @@index([metricName])
  @@index([timestamp])
  @@map("infrastructure_monitoring")
}

model Incident {
  id             String @id @default(cuid())
  organizationId String
  incidentId     String @db.VarChar(50)

  title       String           @db.VarChar(255)
  description String           @db.VarChar(4000)
  severity    IncidentSeverity
  priority    IncidentPriority
  status      IncidentStatus   @default(OPEN)

  affectedAssets   Json? // Array of asset IDs
  affectedServices Json? // Array of service IDs

  detectedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  rootCause  String? @db.VarChar(4000)
  resolution String? @db.VarChar(4000)

  assignedToId String?
  createdById  String 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("IncidentAssignee", fields: [assignedToId], references: [id])
  createdBy    User         @relation("IncidentCreator", fields: [createdById], references: [id])

  @@unique([organizationId, incidentId])
  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@map("incidents")
}

model CapacityPlan {
  id             String @id @default(cuid())
  organizationId String

  planName   String @db.VarChar(255)
  planPeriod String @db.VarChar(100) // e.g., "2025-Q1"

  currentCapacity  Json // Current resource levels
  forecastedDemand Json // Forecasted needs
  expansionPlan    Json // Planned expansions

  budgetEstimate Decimal?  @db.Decimal(15, 2)
  approvedById   String?  
  approvedDate   DateTime?

  status PlanStatus @default(DRAFT)

  createdById String  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("CapacityPlanApprover", fields: [approvedById], references: [id])
  createdBy    User         @relation("CapacityPlanCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@map("capacity_plans")
}

model OperationalAlert {
  id             String @id @default(cuid())
  organizationId String

  alertName String        @db.VarChar(255)
  alertType AlertType
  severity  AlertSeverity
  status    AlertStatus   @default(ACTIVE)

  assetId   String?
  assetType String? @db.VarChar(50)

  condition    String @db.VarChar(500)
  threshold    Float?
  currentValue Float?

  message String @db.VarChar(1000)

  triggeredAt    DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  acknowledgedById String?
  createdById      String 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acknowledgedBy User?        @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id])
  createdBy      User         @relation("AlertCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([assetId, assetType])
  @@map("operational_alerts")
}

model ServiceLevelAgreement {
  id             String @id @default(cuid())
  organizationId String

  serviceId   String
  serviceName String @db.VarChar(255)

  availabilityTarget Float // e.g., 99.9
  performanceTarget  Json // Various performance metrics

  measurementPeriod  String @db.VarChar(50) // Monthly, Quarterly, etc.
  reportingFrequency String @db.VarChar(50)

  penalties Json? // Penalty structure for SLA breach
  credits   Json? // Service credits

  effectiveDate  DateTime
  expirationDate DateTime?

  status SLAStatus @default(ACTIVE)

  ownerId     String
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation("SLAOwner", fields: [ownerId], references: [id])
  createdBy    User         @relation("SLACreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([serviceId])
  @@index([status])
  @@map("service_level_agreements")
}

// ---- Phase 13: Business Case Junction Models & Framework Processes ---- //

model BusinessCaseValueStream {
  id             String       @id
  businessCaseId String      
  valueStreamId  String      
  contribution   String       @db.VarChar(50)
  expectedValue  Decimal?     @db.Decimal(15, 2)
  timeline       String?      @db.VarChar(500)
  BusinessCase   BusinessCase @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  ValueStream    ValueStream  @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)

  @@unique([businessCaseId, valueStreamId])
  @@index([businessCaseId])
  @@index([valueStreamId])
}

model ProductBusinessCase {
  id             String       @id(map: "PK_ProductBusinessCase")
  productId      String      
  businessCaseId String      
  relationship   String       @default("supports") @db.VarChar(100)
  contribution   String?      @db.VarChar(500)
  impact         String?      @db.VarChar(500)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  BusinessCase   BusinessCase @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  Product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, businessCaseId])
  @@index([businessCaseId], map: "IX_ProductBusinessCase_businessCaseId")
  @@index([productId], map: "IX_ProductBusinessCase_productId")
}

model ProductValueStream {
  id            String      @id
  productId     String     
  valueStreamId String     
  relationship  String      @db.VarChar(50)
  contribution  Decimal?    @db.Decimal(5, 2)
  Product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  ValueStream   ValueStream @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)

  @@unique([productId, valueStreamId])
  @@index([productId])
  @@index([valueStreamId])
}

model COBITProcess {
  id          String      @id @default(cuid())
  frameworkId String     
  processCode String      @db.VarChar(20) // e.g., EDM01, APO12, BAI01
  processName String      @db.VarChar(255)
  domain      COBITDomain // EDM, APO, BAI, DSS, MEA
  description String?     @db.VarChar(2000)
  purpose     String?     @db.VarChar(1000)

  // Process maturity and implementation
  maturityLevel        COBITProcessMaturity        @default(INCOMPLETE)
  implementationStatus ProcessImplementationStatus @default(NOT_STARTED)
  riskLevel            RiskLevel                   @default(MEDIUM)
  priority             FrameworkPriority           @default(MEDIUM)

  // Process details
  inputs    Json? // Expected inputs
  outputs   Json? // Expected outputs 
  raci      Json? // RACI matrix
  kpis      Json? // Key performance indicators
  controls  Json? // Control objectives
  practices Json? // Management practices

  // Business relationships
  relatedBusinessProcesses Json? // Links to business processes
  governanceObjectives     Json? // Governance objectives addressed

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Framework     COBITFramework             @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  businessCases BusinessCaseCOBITProcess[]

  @@unique([frameworkId, processCode])
  @@index([frameworkId], map: "IX_COBITProcess_frameworkId")
  @@index([domain], map: "IX_COBITProcess_domain")
  @@index([maturityLevel], map: "IX_COBITProcess_maturityLevel")
  @@map("cobit_processes")
}

model PCFProcess {
  id          String             @id @default(cuid())
  frameworkId String            
  processCode String             @db.VarChar(20) // e.g., 1.1, 2.3, 12.4
  processName String             @db.VarChar(255)
  level       PCFProcessLevel // LEVEL_1, LEVEL_2, LEVEL_3, LEVEL_4
  category    PCFProcessCategory // Maps to the 12 major categories
  description String?            @db.VarChar(2000)
  purpose     String?            @db.VarChar(1000)

  // Process standardization and implementation  
  standardizationLevel PCFProcessStandardization   @default(UNDEFINED)
  implementationStatus ProcessImplementationStatus @default(NOT_STARTED)
  automationLevel      ProcessAutomationLevel      @default(MANUAL)
  priority             FrameworkPriority           @default(MEDIUM)

  // Process details
  inputs        Json? // Process inputs
  outputs       Json? // Process outputs
  kpis          Json? // Key performance indicators
  bestPractices Json? // Industry best practices
  benchmarks    Json? // Performance benchmarks

  // Business relationships
  relatedValueStreams Json? // Connected value streams
  customerImpact      String? @db.VarChar(1000)
  operationalImpact   String? @db.VarChar(1000)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Framework     PCFFramework             @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  businessCases BusinessCasePCFProcess[]

  @@unique([frameworkId, processCode])
  @@index([frameworkId], map: "IX_PCFProcess_frameworkId")
  @@index([category], map: "IX_PCFProcess_category")
  @@index([level], map: "IX_PCFProcess_level")
  @@index([standardizationLevel], map: "IX_PCFProcess_standardizationLevel")
  @@map("pcf_processes")
}

model BusinessCaseCOBIT {
  id                   String                @id @default(cuid())
  businessCaseId       String               
  cobitFrameworkId     String               
  relationship         CaseFrameworkRelation @default(SUPPORTS)
  governanceObjective  String?               @db.VarChar(500)
  riskMitigation       String?               @db.VarChar(1000)
  complianceImpact     String?               @db.VarChar(1000)
  expectedMaturityGain Int                   @default(0)
  priority             FrameworkPriority     @default(MEDIUM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  BusinessCase   BusinessCase   @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  COBITFramework COBITFramework @relation(fields: [cobitFrameworkId], references: [id], onDelete: Cascade)

  @@unique([businessCaseId, cobitFrameworkId])
  @@index([businessCaseId], map: "IX_BusinessCaseCOBIT_businessCaseId")
  @@index([cobitFrameworkId], map: "IX_BusinessCaseCOBIT_cobitFrameworkId")
  @@map("business_case_cobit")
}

model BusinessCaseCOBITProcess {
  id                  String              @id @default(cuid())
  businessCaseId      String             
  cobitProcessId      String             
  relationship        CaseProcessRelation @default(IMPLEMENTS)
  impactLevel         ImpactLevel         @default(MEDIUM)
  maturityImprovement Int                 @default(0)
  implementation      String?             @db.VarChar(1000)
  expectedOutcome     String?             @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  BusinessCase BusinessCase @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  COBITProcess COBITProcess @relation(fields: [cobitProcessId], references: [id], onDelete: Cascade)

  @@unique([businessCaseId, cobitProcessId])
  @@index([businessCaseId], map: "IX_BusinessCaseCOBITProcess_businessCaseId")
  @@index([cobitProcessId], map: "IX_BusinessCaseCOBITProcess_cobitProcessId")
  @@map("business_case_cobit_process")
}

model BusinessCasePCF {
  id                     String                @id @default(cuid())
  businessCaseId         String               
  pcfFrameworkId         String               
  relationship           CaseFrameworkRelation @default(SUPPORTS)
  processStandardization String?               @db.VarChar(500)
  operationalImpact      String?               @db.VarChar(1000)
  customerImpact         String?               @db.VarChar(1000)
  expectedEfficiencyGain Int                   @default(0)
  priority               FrameworkPriority     @default(MEDIUM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  BusinessCase BusinessCase @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  PCFFramework PCFFramework @relation(fields: [pcfFrameworkId], references: [id], onDelete: Cascade)

  @@unique([businessCaseId, pcfFrameworkId])
  @@index([businessCaseId], map: "IX_BusinessCasePCF_businessCaseId")
  @@index([pcfFrameworkId], map: "IX_BusinessCasePCF_pcfFrameworkId")
  @@map("business_case_pcf")
}

model BusinessCasePCFProcess {
  id                  String              @id @default(cuid())
  businessCaseId      String             
  pcfProcessId        String             
  relationship        CaseProcessRelation @default(STANDARDIZES)
  impactLevel         ImpactLevel         @default(MEDIUM)
  standardizationGain String?             @db.VarChar(500)
  processImprovement  String?             @db.VarChar(1000)
  expectedOutcome     String?             @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  BusinessCase BusinessCase @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)
  PCFProcess   PCFProcess   @relation(fields: [pcfProcessId], references: [id], onDelete: Cascade)

  @@unique([businessCaseId, pcfProcessId])
  @@index([businessCaseId], map: "IX_BusinessCasePCFProcess_businessCaseId")
  @@index([pcfProcessId], map: "IX_BusinessCasePCFProcess_pcfProcessId")
  @@map("business_case_pcf_process")
}

// ---- Phase 13 Batch 2: Resource Junctions & Opportunity Extensions ---- //

model CapabilityResource {
  id           String     @id
  capabilityId String    
  resourceId   String    
  usage        String     @db.VarChar(50)
  intensity    String     @db.VarChar(20)
  Capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  Resource     Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, resourceId])
  @@index([capabilityId])
  @@index([resourceId])
}

model KpiResource {
  id         String   @id
  kpiId      String  
  resourceId String  
  allocation Decimal  @db.Decimal(5, 2)
  impact     String?  @db.VarChar(50)
  Kpi        Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  Resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([kpiId, resourceId])
  @@index([kpiId])
  @@index([resourceId])
}

model ValueStreamCapability {
  id            String      @id
  valueStreamId String     
  capabilityId  String     
  relationship  String      @db.VarChar(50)
  criticality   String      @db.VarChar(20)
  Capability    Capability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  ValueStream   ValueStream @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)

  @@unique([valueStreamId, capabilityId])
  @@index([capabilityId])
  @@index([valueStreamId])
}

model OpportunityActivity {
  id            String          @id(map: "PK_OpportunityActivity") @default(cuid())
  opportunityId String         
  activityType  ActivityTypeOpp
  subject       String          @db.VarChar(255)
  description   String?         @db.VarChar(2000)
  activityDate  DateTime
  duration      Int? // in minutes
  outcome       String?         @db.VarChar(500)
  createdAt     DateTime        @default(now())
  createdBy     String         

  Opportunity SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade, map: "FK_OpportunityActivity_Opportunity")
  Creator     User             @relation("OpportunityActivityCreator", fields: [createdBy], references: [id], map: "FK_OpportunityActivity_Creator")

  @@index([opportunityId], map: "IX_OpportunityActivity_opportunityId")
  @@index([activityDate], map: "IX_OpportunityActivity_activityDate")
}

model OpportunityNote {
  id            String   @id(map: "PK_OpportunityNote") @default(cuid())
  opportunityId String  
  content       String   @db.Text
  isPrivate     Boolean  @default(false)
  createdAt     DateTime @default(now())
  createdBy     String  

  Opportunity SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade, map: "FK_OpportunityNote_Opportunity")
  Creator     User             @relation("OpportunityNoteCreator", fields: [createdBy], references: [id], map: "FK_OpportunityNote_Creator")

  @@index([opportunityId], map: "IX_OpportunityNote_opportunityId")
}

// ---- Phase 14: Architecture Models ---- //

model ArchitectureDecision {
  id                                        String       @id
  organizationId                            String      
  title                                     String       @db.VarChar(255)
  description                               String?      @db.VarChar(2000)
  context                                   String?      @db.VarChar(4000)
  decision                                  String       @db.VarChar(4000)
  status                                    String       @default("proposed") @db.VarChar(50)
  alternatives                              Json?
  consequences                              Json?
  rationale                                 String?      @db.VarChar(2000)
  stakeholders                              Json?
  impactedSystems                           Json?
  reviewDate                                DateTime?
  nextReviewDate                            DateTime?
  supersededBy                              String?     
  supersedes                                String?     
  category                                  String       @default("technical") @db.VarChar(100)
  priority                                  String       @default("medium") @db.VarChar(50)
  effort                                    String?      @db.VarChar(50)
  risk                                      String?      @db.VarChar(50)
  assumptions                               String?      @db.VarChar(2000)
  constraints                               String?      @db.VarChar(2000)
  futureConsiderations                      String?      @db.VarChar(2000)
  relatedDecisions                          String?      @db.VarChar(1000)
  decisionMakers                            String?      @db.VarChar(500)
  reviewer                                  String?      @db.VarChar(255)
  approver                                  String?      @db.VarChar(255)
  decisionDate                              DateTime?
  implementationStatus                      String?      @db.VarChar(100)
  compliance                                String?      @db.VarChar(500)
  documentation                             String?      @db.VarChar(500)
  isActive                                  Boolean      @default(true)
  metadata                                  Json?
  tags                                      Json?
  createdAt                                 DateTime     @default(now())
  updatedAt                                 DateTime
  createdBy                                 String      
  updatedBy                                 String?     
  User_ArchitectureDecision_createdByToUser User         @relation("ArchitectureDecision_createdByToUser", fields: [createdBy], references: [id], onDelete: Cascade)
  Organization                              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User_ArchitectureDecision_updatedByToUser User?        @relation("ArchitectureDecision_updatedByToUser", fields: [updatedBy], references: [id])

  @@index([category], map: "IX_ArchitectureDecision_category")
  @@index([createdBy], map: "IX_ArchitectureDecision_createdBy")
  @@index([organizationId], map: "IX_ArchitectureDecision_organizationId")
  @@index([priority], map: "IX_ArchitectureDecision_priority")
  @@index([status], map: "IX_ArchitectureDecision_status")
  @@index([updatedBy], map: "IX_ArchitectureDecision_updatedBy")
}

model Deliverable {

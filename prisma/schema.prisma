  userAgent           String?                    @db.Text
  referrer            String?                    @db.Text
  metadata            Json?

  organization        Organization               @relation("FrameworkAnalyticsOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                       @relation("FrameworkAnalyticsUser", fields: [userId], references: [id])
  events              FrameworkAnalyticsEvent[]

  @@index([organizationId])
  @@index([userId])
  @@index([sessionStarted])
  @@index([sessionType])
  @@map("framework_analytics_sessions")
}

model FrameworkAnalyticsEvent {
  id                  String                     @id @default(cuid())
  sessionId           String
  frameworkId         String?
  frameworkName       String?                    @db.VarChar(255)
  eventType           FrameworkEventType
  eventData           Json?
  timestamp           DateTime                   @default(now())
  organizationId      String
  userId              String

  session             FrameworkAnalyticsSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organization        Organization               @relation("FrameworkEventOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                       @relation("FrameworkEventUser", fields: [userId], references: [id])

  @@index([sessionId])
  @@index([frameworkId])
  @@index([eventType])
  @@index([timestamp])
  @@index([organizationId])
  @@map("framework_analytics_events")
}

model FrameworkUsageMetrics {
  id                  String     @id @default(cuid())
  frameworkId         String
  frameworkName       String     @db.VarChar(255)
  organizationId      String
  totalViews          Int        @default(0)
  totalInstallations  Int        @default(0)
  totalCompletions    Int        @default(0)
  avgTimeToInstall    Int?       // seconds
  avgCompletionTime   Int?       // minutes
  successRate         Float?     // percentage
  lastUsed            DateTime?
  popularityScore     Float      @default(0.0)
  effectivenessScore  Float      @default(0.0)
  weeklyViews         Int        @default(0)
  monthlyViews        Int        @default(0)
  calculatedAt        DateTime   @default(now())

  organization        Organization @relation("FrameworkMetricsOrganization", fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, organizationId])
  @@index([frameworkName])
  @@index([organizationId])
  @@index([popularityScore])
  @@index([calculatedAt])
  @@map("framework_usage_metrics")
}

model FrameworkRecommendationMetrics {
  id                      String     @id @default(cuid())
  organizationId          String
  userId                  String
  recommendationType      RecommendationType
  frameworkId             String
  frameworkName           String     @db.VarChar(255)
  recommendationSource    String     @db.VarChar(100) // 'ai_engine', 'industry_match', 'size_based', etc.
  recommendationScore     Float
  wasAccepted             Boolean    @default(false)
  wasInstalled            Boolean    @default(false)
  timeToAction            Int?       // seconds from recommendation to action
  rejectionReason         String?    @db.VarChar(255)
  feedbackScore           Int?       // 1-5 rating
  createdAt               DateTime   @default(now())

  organization            Organization @relation("FrameworkRecommendationOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User       @relation("FrameworkRecommendationUser", fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([recommendationType])
  @@index([frameworkId])
  @@index([wasAccepted])
  @@index([createdAt])
  @@map("framework_recommendation_metrics")
}

model FrameworkBundleAnalytics {
  id                  String     @id @default(cuid())
  bundleId            String     @db.VarChar(100)
  bundleName          String     @db.VarChar(255)
  organizationId      String
  userId              String
  viewCount           Int        @default(0)
  installCount        Int        @default(0)
  completionRate      Float?     // percentage of frameworks in bundle completed
  timeToComplete      Int?       // minutes to complete entire bundle
  abandonmentStage    String?    @db.VarChar(100) // which framework in bundle user stopped at
  userRating          Int?       // 1-5 stars
  businessValue       Float?     // calculated business impact score
  lastInteraction     DateTime   @default(now())

  organization        Organization @relation("FrameworkBundleOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  user                User       @relation("FrameworkBundleUser", fields: [userId], references: [id])

  @@index([bundleId])
  @@index([organizationId])
  @@index([userId])
  @@index([lastInteraction])
  @@map("framework_bundle_analytics")
}

enum FrameworkSessionType {
  MARKETPLACE
  ONBOARDING
  DASHBOARD
  SEARCH
  RECOMMENDATION
}

enum FrameworkEventType {
  // Discovery Events
  FRAMEWORK_VIEWED
  FRAMEWORK_DETAILS_OPENED
  FRAMEWORK_SEARCHED
  CATEGORY_BROWSED
  
  // Installation Events
  FRAMEWORK_INSTALL_STARTED
  FRAMEWORK_INSTALL_COMPLETED
  FRAMEWORK_INSTALL_FAILED
  BUNDLE_INSTALL_STARTED
  BUNDLE_INSTALL_COMPLETED
  
  // Usage Events
  FRAMEWORK_LAUNCHED
  FRAMEWORK_CONFIGURED
  TEMPLATE_USED
  ASSESSMENT_STARTED
  ASSESSMENT_COMPLETED
  
  // Engagement Events
  DOCUMENTATION_VIEWED
  VIDEO_WATCHED
  TUTORIAL_COMPLETED
  HELP_REQUESTED
  
  // Recommendation Events
  RECOMMENDATION_SHOWN
  RECOMMENDATION_ACCEPTED
  RECOMMENDATION_DISMISSED
  FEEDBACK_PROVIDED
}


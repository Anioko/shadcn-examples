  User_Deliverable_updatedByToUser User?        @relation("Deliverable_updatedByToUser", fields: [updatedBy], references: [id])
  WorkPackage                      WorkPackage? @relation(fields: [workPackageId], references: [id])

  @@index([createdBy], map: "IX_Deliverable_createdBy")
  @@index([organizationId], map: "IX_Deliverable_organizationId")
  @@index([priority], map: "IX_Deliverable_priority")
  @@index([status], map: "IX_Deliverable_status")
  @@index([type], map: "IX_Deliverable_type")
  @@index([updatedBy], map: "IX_Deliverable_updatedBy")
  @@index([workPackageId], map: "IX_Deliverable_workPackageId")
}

model Gap {
  id                       String       @id
  organizationId           String      
  name                     String       @db.VarChar(255)
  description              String?      @db.VarChar(2000)
  type                     String       @default("capability") @db.VarChar(100)
  category                 String       @default("technical") @db.VarChar(100)
  severity                 String       @default("medium") @db.VarChar(50)
  impact                   String       @default("medium") @db.VarChar(50)
  urgency                  String       @default("medium") @db.VarChar(50)
  status                   String       @default("identified") @db.VarChar(50)
  current_state            String?      @db.VarChar(2000)
  desired_state            String?      @db.VarChar(2000)
  gap_size                 String?      @db.VarChar(50)
  root_cause               String?      @db.VarChar(2000)
  analysis                 Json?
  recommendations          Json?
  alternatives             Json?
  dependencies             Json?
  barriers                 Json?
  enablers                 Json?
  risks                    Json?
  opportunities            Json?
  cost_estimate            Decimal?     @db.Decimal(12, 2)
  effort_estimate          Int?
  timeline                 String?      @db.VarChar(100)
  business_case            String?      @db.VarChar(2000)
  stakeholders             Json?
  workPackages             Json?
  deliverables             Json?
  successCriteria          Json?        @map("success_criteria")
  metrics                  Json?
  milestones               Json?
  owner                    String?      @db.VarChar(255)
  analyst                  String?      @db.VarChar(255)
  sponsor                  String?      @db.VarChar(255)
  priority_score           Int?         @default(0)

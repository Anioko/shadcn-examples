  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
  OVERDUE
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FrameworkMilestoneType {
  PHASE_COMPLETION
  ASSESSMENT_COMPLETE
  TRAINING_COMPLETE
  DOCUMENTATION_COMPLETE
  GO_LIVE
  REVIEW_COMPLETE
  CERTIFICATION_ACHIEVED
}

enum FrameworkMilestoneStatus {
  PENDING

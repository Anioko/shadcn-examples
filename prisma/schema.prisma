  name        String  @db.VarChar(255)
  description String? @db.VarChar(2000)
  accountId   String?
  contactId   String?

  // Financial Fields
  amount         Decimal @db.Decimal(15, 2)
  currency       String  @default("USD") @db.VarChar(3)
  probability    Int     @default(0)
  weightedAmount Decimal @db.Decimal(15, 2)

  // Pipeline Fields
  stage  OpportunityStage   @default(NEW)
  status OpportunityStatus  @default(OPEN)
  source OpportunitySource?
  type   OpportunityType?

  // Timeline Fields
  closeDate        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastActivityDate DateTime?
  stageEnteredDate DateTime?

  // Assignment Fields
  ownerId     String                 
  teamMembers OpportunityTeamMember[]

  // Competitive Intelligence
  primaryCompetitor String?  @db.VarChar(255)
  competitors       String[]

  // Loss Analysis
  lossReason LossReason?
  lossNotes  String?     @db.VarChar(1000)

  // Metadata
  tags         String[]
  customFields Json?

  createdBy String 
  updatedBy String?

  // Relations
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "FK_SalesOpportunity_Organization")
  owner        User           @relation("OpportunityOwner", fields: [ownerId], references: [id], map: "FK_SalesOpportunity_Owner")
  account      BusinessActor? @relation("OpportunityAccount", fields: [accountId], references: [id], map: "FK_SalesOpportunity_Account")
  contact      Contact?       @relation(fields: [contactId], references: [id], map: "FK_SalesOpportunity_Contact")

  activities OpportunityActivity[]
  products   OpportunityProduct[]
  notes      OpportunityNote[]

  @@index([organizationId], map: "IX_SalesOpportunity_organizationId")
  @@index([ownerId], map: "IX_SalesOpportunity_ownerId")
  @@index([stage], map: "IX_SalesOpportunity_stage")
  @@index([status], map: "IX_SalesOpportunity_status")
  @@index([closeDate], map: "IX_SalesOpportunity_closeDate")
  @@index([organizationId, stage, status], map: "IX_SalesOpportunity_org_stage_status")
  @@index([organizationId, ownerId], map: "IX_SalesOpportunity_org_owner")
}


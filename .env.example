# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/reqarchitect"

# ============================================
# KANBAN FEATURE FLAGS
# ============================================
# Set to 'true' to use database-driven Kanban boards
# Set to 'false' (or leave unset) to use mock data (default for development)
KANBAN_USE_DATABASE=false

# Default organization ID for Kanban boards (when no organizationId is provided)
# Optional - only needed when KANBAN_USE_DATABASE=true
DEFAULT_ORG_ID=

# ============================================
# NEXT.JS CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file to .env:
#    cp .env.example .env (or copy manually)
#
# 2. For MOCK DATA MODE (no database required - DEFAULT):
#    - Leave KANBAN_USE_DATABASE=false or unset
#    - Run: npm run dev
#    - Visit: http://localhost:3000/frameworks/scrum/kanban
#    - ✅ Works immediately with mock data!
#
# 3. For DATABASE MODE (production):
#    - Set KANBAN_USE_DATABASE=true
#    - Configure DATABASE_URL with your PostgreSQL credentials
#    - Run: npx prisma generate (already done during npm install)
#    - Run: npx prisma db push
#    - Run: npm run dev
#    - Visit: http://localhost:3000/frameworks/scrum/kanban?organizationId=YOUR_ORG_ID
#
# Note: Prisma packages and client are already installed!
